# Nur für lokale Entwicklung. Für andere Umgebungen sichere Werte setzen.
POSTGRES_PASSWORD=jeopardy-local
WEB_PORT=8080
# API-Ziel aus Sicht des Webcontainers, ohne /api und ohne abschließenden Slash.
JEOPARDY_API_URL=http://api:3001
PGADMIN_PORT=5050
# False: ohne Login (nur lokal). True: Anmeldung mit den folgenden Zugangsdaten.
PGADMIN_SERVER_MODE=False
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=pgadmin-local
# Leer: API ist read-only. Für PUT-Zugriffe einen eigenen langen Zufallswert setzen.
CONTENT_WRITE_TOKEN=
# Optional: erlaubte Browser-Origins der zweiten Anwendung, kommagetrennt.
CORS_ORIGINS=