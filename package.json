{
  "name": "web-jeopardy",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Jeopardy-Webanwendung für Moderator und Beamer – lokal spielbar, später multiplayerfähig",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @jeopardy/web",
    "dev:api": "npm run dev --workspace @jeopardy/api",
    "db:migrate": "npm run db:migrate --workspace @jeopardy/api",
    "db:import": "npm run db:import --workspace @jeopardy/api",
    "db:seed": "npm run db:seed --workspace @jeopardy/api",
    "build": "npm run build --workspace @jeopardy/web",
    "preview": "npm run preview --workspace @jeopardy/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p packages/game-core --noEmit && tsc -p apps/web --noEmit && tsc -p apps/api --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:junit": "vitest run --coverage --reporter=default --reporter=junit --outputFile.junit=reports/unit.xml",
    "test:e2e": "playwright test",
    "test:db": "vitest run --config apps/api/vitest.integration.config.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "build:info": "tsx scripts/write-build-info.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
